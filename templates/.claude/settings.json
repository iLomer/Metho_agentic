{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs'),p=require('path');try{const t=fs.readFileSync(p.join(process.env.CLAUDE_PROJECT_DIR||'.','ai/handoff/current.md'),'utf8');console.log('Handoff from the previous session (ai/handoff/current.md):');console.log(t)}catch{}\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo Keep in the summary: the active slice ID and its board column, acceptance criteria not yet met, files changed but not committed, and decisions not yet written to ai/context/decisions.md."
          }
        ]
      }
    ]
  }
}
